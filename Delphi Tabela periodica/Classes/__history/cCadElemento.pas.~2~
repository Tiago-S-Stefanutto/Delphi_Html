unit cCadElemento;

interface

uses
  System.Classes, Vcl.Controls, Vcl.ExtCtrls, Vcl.Dialogs, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys, FireDAC.Phys.MSSQL,
  FireDAC.Phys.MSSQLDef, FireDAC.VCLUI.Wait, Data.DB, FireDAC.Comp.Client, System.SysUtils, FireDAC.Stan.Param;

type
  TElemento = class

    private
      F_elementoId : integer;
      F_numero_atomico : integer;
      F_simbolo : string;
      F_nome : string;
      F_massa_atomica : Double;
      F_grupo : integer;
      F_periodo : integer;
      F_familia : integer;
      F_categoria_quimica : Integer;

    public
      constructor Create(aConexao: TFDConnection);
      destructor  Destroy; override;

      function Inserir:Boolean;
      function Atualizar:Boolean;
      function Apagar:Boolean;
      function Selecionar(id:Integer):Boolean;

    published
      property codigo       : integer read F_elementoId        write F_elementoId;
      property atomico      : integer read F_numero_atomico    write F_numero_atomico;
      property simbolo      : string  read F_simbolo           write F_simbolo;
      property nome         : string  read F_nome              write F_nome;
      property massa        : integer read F_massa_atomica     write F_massa_atomica ;
      property grupo        : integer read F_grupo             write F_grupo;
      property periodo      : integer read F_periodo           write F_periodo;
      property familia      : integer read F_familia           write F_familia;
      property categoria    : integer read F_categoria_quimica write F_categoria_quimica;


end;


implementation

end.
